<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Fully portable: no System.Drawing / OS dependency anywhere in the library.
         netstandard2.0 keeps it usable from .NET Framework and Unity;
         net10.0 is the primary modern target. -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <RootNamespace>RasterField</RootNamespace>
    <AssemblyName>RasterField.Core</AssemblyName>
    <Product>RasterField</Product>
    <Description>Portable .NET library for the ERDAS ER Mapper raster dataset format (.ers header + BIL data file): robust reading and writing, georeferencing, statistics, and palette-based colourisation into a plain BGRA image buffer.</Description>
    <Authors>RasterField</Authors>
    <Version>1.0.0</Version>
    <PackageId>RasterField.Core</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- GeoJSON and project files: System.Text.Json is in-box on net10.0, a package on netstandard2.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
